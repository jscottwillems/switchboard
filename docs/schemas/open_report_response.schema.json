{
  "$defs": {
    "ReportFormat": {
      "enum": [
        "json",
        "markdown",
        "pdf_ready",
        "csv",
        "campaign_summary"
      ],
      "title": "ReportFormat",
      "type": "string"
    },
    "ReportKind": {
      "enum": [
        "single_call",
        "multi_call_campaign",
        "technical_incident",
        "machine_readable_json"
      ],
      "title": "ReportKind",
      "type": "string"
    },
    "ReportPart": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "content_type",
        "body"
      ],
      "title": "ReportPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Response of POST /clerk/reports/open.\n\nCSV responses contain one part per table. `primary_filename` selects the\npart a single-document client should show. Other formats have one part.",
  "properties": {
    "format": {
      "$ref": "#/$defs/ReportFormat"
    },
    "kind": {
      "$ref": "#/$defs/ReportKind"
    },
    "package_id": {
      "title": "Package Id",
      "type": "string"
    },
    "package_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Package Ids",
      "type": "array"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/ReportPart"
      },
      "minItems": 1,
      "title": "Parts",
      "type": "array"
    },
    "primary_filename": {
      "title": "Primary Filename",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "report_id",
    "package_id",
    "package_ids",
    "kind",
    "format",
    "synthetic",
    "primary_filename",
    "parts"
  ],
  "title": "OpenReportResponse",
  "type": "object"
}
