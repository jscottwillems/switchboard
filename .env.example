SWITCHBOARD_ENV=dev
SWITCHBOARD_DEV_WEBHOOK_BYPASS=1
# Local placeholder. Rotate before any shared URL. Not a production secret.
SWITCHBOARD_INTERNAL_TOKEN=dev-internal-token
# Local placeholder for GET /v1/calls and GET /v1/campaigns. Not a production secret.
# Comparison is constant-time. Leave the bypass unset so reads still require this token.
# Compose feeds this same value to the dashboard image as VITE_OPERATOR_TOKEN.
# Rebuild that image after it changes. Vite inlines the value. This is not a login.
SWITCHBOARD_OPERATOR_TOKEN=dev-operator-token
# SWITCHBOARD_DEV_OPERATOR_BYPASS=1
# Do not use *. The phone uses the dashboard origin, so it does not need a LAN origin here.
SWITCHBOARD_CORS_ORIGINS=http://localhost:5173
# Local carrier URL. When the ingress edge proxies /v1/streams, use wss:// and not ws://.
# MEDIA_GATEWAY_PUBLIC_WS=wss://board.example.com/v1/streams
MEDIA_GATEWAY_PUBLIC_WS=ws://localhost:8001/v1/streams
API_BASE_URL=http://localhost:8000
STREAM_TOKEN_VALIDATE_TIMEOUT_S=2
DATABASE_URL=postgresql://switchboard:switchboard@localhost:5432/switchboard
REDIS_URL=redis://localhost:6379/0
# Optional. Leave unset so the dashboard calls same-origin /v1.
# http://localhost:8000 points a phone at itself. The compose image ignores this
# and proxies /v1. Set it only when the browser should call another origin.
# VITE_API_BASE_URL=http://localhost:8000
# mock keeps the dashboard on fixtures. api (or unset) reads GET /v1/calls.
VITE_OPS_DATA=api
VITE_LIVE_POLL_MS=5000
# Sent as X-Switchboard-Operator-Token. Must match SWITCHBOARD_OPERATOR_TOKEN.
# Ignored when VITE_OPS_DATA=mock. Vite inlines this at dev-server start and at build.
# `npm run dev` reads apps/dashboard/.env. Compose reads the value above as a build arg.
VITE_OPERATOR_TOKEN=dev-operator-token

# Opt-in HTTPS. Unset leaves `docker compose up` on LAN HTTP. See README.
# Rotate the operator and internal tokens above before any shared URL.
# There is no per-operator login. Postgres and Redis stay off the ingress.
# SWITCHBOARD_PUBLIC_HOST=
# SWITCHBOARD_ACME_EMAIL=
# CLOUDFLARE_TUNNEL_TOKEN=
