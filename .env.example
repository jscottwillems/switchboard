# Local defaults. Change the mock secret before exposing the process beyond localhost.
SWITCHBOARD_PUBLIC_BASE_URL=http://localhost:8000
SWITCHBOARD_MEDIA_WS_BASE_URL=ws://localhost:8000
SWITCHBOARD_MOCK_WEBHOOK_SECRET=dev-mock-secret
SWITCHBOARD_LOG_LEVEL=INFO

# Required only when a real Twilio account points at this process.
# SWITCHBOARD_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SWITCHBOARD_TWILIO_AUTH_TOKEN=your-auth-token
