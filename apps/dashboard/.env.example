# Copy to apps/dashboard/.env. Vite reads this directory, not the repo root.
# Leave VITE_API_BASE_URL unset. Dev and preview then proxy /v1 to 127.0.0.1:8000,
# and the compose image proxies /v1 to the API. A phone can open the dashboard host.
# Set an absolute origin only when the browser should call that host directly.
# That origin must be listed in SWITCHBOARD_CORS_ORIGINS.
# VITE_API_BASE_URL=http://localhost:8000

# mock: fixtures, no network. api or unset: GET /v1/calls and GET /v1/calls/{id}.
VITE_OPS_DATA=api
VITE_LIVE_POLL_MS=5000
