# Copy to apps/dashboard/.env. Vite reads this directory, not the repo root.
# Leave VITE_API_BASE_URL unset so `npm run dev` proxies /v1 to 127.0.0.1:8000.
# Set it to call the API origin directly (the browser then needs CORS).
# VITE_API_BASE_URL=http://localhost:8000

# mock: fixtures, no network. api or unset: GET /v1/calls and GET /v1/calls/{id}.
VITE_OPS_DATA=api
VITE_LIVE_POLL_MS=5000
